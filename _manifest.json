{
  "manifest_version": 2,
  "id": "github.x1a0he1.maibot-jm-bot",
  "version": "1.0.1",
  "name": "JM-bot 漫画工具",
  "description": "在 QQ 使用 JM-bot 搜索、收藏、预览和管理漫画下载队列",
  "author": {
    "name": "x1a0he1",
    "url": "https://github.com/x1a0he1"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/x1a0he1/maibot-jm-bot",
    "documentation": "https://github.com/x1a0he1/maibot-jm-bot#readme",
    "issues": "https://github.com/x1a0he1/maibot-jm-bot/issues"
  },
  "host_application": {
    "min_version": "1.4.8",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "websockets",
      "version_spec": ">=16"
    },
    {
      "type": "python_package",
      "name": "nonebot2",
      "version_spec": ">=2.5.0"
    },
    {
      "type": "python_package",
      "name": "nonebot-adapter-onebot",
      "version_spec": ">=2.4.6"
    },
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.7.12,<3"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10"
    },
    {
      "type": "python_package",
      "name": "img2pdf",
      "version_spec": ">=0.6.3"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8.2"
    },
    {
      "type": "python_package",
      "name": "fastapi",
      "version_spec": ">=0.115"
    },
    {
      "type": "python_package",
      "name": "uvicorn",
      "version_spec": ">=0.30"
    }
  ],
  "capabilities": [
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool"
}
